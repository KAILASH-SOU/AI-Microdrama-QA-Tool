# Pre-Render Script Health Gatekeeper Environment Configuration

# Swappable LLM Provider (options: gemini, openai, anthropic, groq, generic_openai)
LLM_PROVIDER=gemini

# Primary Default: Google Gemini (Free Tier Friendly)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Groq Configuration (Ultra-fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-Compatible / Custom Endpoint
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_MODEL=

# Execution & Caching Settings
CACHE_DIR=.cache
OUTPUT_DIR=outputs
MAX_RETRIES=5
INITIAL_RETRY_DELAY_SEC=2.0
